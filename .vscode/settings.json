{
    "go.toolsEnvVars": {
        "CGO_ENABLED": "0"
    },
    "FSharp.suggestGitignore": false,
    "fortran.fortls.disabled": true,
    "code-runner.runInTerminal": true,
    "C_Cpp.default.cStandard": "gnu23",
    "C_Cpp.default.cppStandard": "gnu++26",
    "workbench.iconTheme": "material-icon-theme",
    "files.associations": {
        "*.bas": "freebasic",
        "*.e": "eiffel",
        "*.factor": "factor",
        "*.icn": "unicon",
        "*.m": "objective-c",
        "*.m3": "m3",
        "*.mat": "octave",
        "*.mmc": "mercury",
        "*.mms": "mmix",
        "*.Mod": "oberon",
        "*.pl": "prolog",
        "*.plx": "perl",
        "*.rkt": "racket",
        "*.st": "smalltalk",
        "*.kit": "kit",
        "*.vb": "vb"
    },
    "material-icon-theme.files.associations": {
        "*.bas": "../../icons/freebasic",
        "*.e": "../../icons/eiffel",
        "*.factor": "../../icons/factor",
        "*.gleam": "../../icons/gleam",
        "*.icn": "../../icons/icon",
        "*.kit": "../../icons/kit",
        "*.m": "../../icons/objective-c",
        "*.m3": "../../icons/modula3",
        "*.mat": "../../icons/octave",
