{
    "go.toolsEnvVars": {
        "CGO_ENABLED": "0"
    },
    "FSharp.suggestGitignore": false,
    "fortran.fortls.disabled": true,
    "code-runner.executorMap": {
        "javascript": "node",
        "java": "cd $dir && mkdir -p output && javac $fileName -d output && dir=${PWD%/*}; packName=\"${dir##*/}\"; algoName=\"${PWD##*/}\" && cd output && java \"${packName}.${algoName}.$fileNameWithoutExt\"",
        "c": "cd $dir && mkdir -p output && gcc $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "zig": "zig run",
        "cpp": "cd $dir && mkdir -p output && g++ $fileName -o output/$fileNameWithoutExt -std=c++23 && $dir/output/$fileNameWithoutExt",
        "objective-c": "cd $dir && mkdir -p output && clang -lobjc -lgnustep-base `gnustep-config --objc-flags` `gnustep-config --objc-libs` -L/usr/local/lib  $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "php": "php",
        "python": "python -u",
        "perl": "perl",
        "perl6": "perl6",
        "ruby": "ruby",
        "go": "go run",
        "lua": "lua",
        "groovy": "groovy",
        "powershell": "powershell -ExecutionPolicy ByPass -File",
        "bat": "cmd /c",
        "shellscript": "bash",
        "fsharp": "dotnet fsi",
        "csharp": "dotnet run",
        "vbscript": "cscript //Nologo",
        "typescript": "cd $dir && mkdir -p output && tsc $fileName --outDir output --target esnext --skipLibCheck true && node $dir/output/$fileNameWithoutExt.js",
        "coffeescript": "coffee",
        "scala": "scala run $dir$fileName -- 15 10",
        "swift": "swift",
        "julia": "julia",
        "crystal": "crystal",
        "ocaml": "ocaml",
        "r": "Rscript",
        "applescript": "osascript",
        "clojure": "lein exec",
        "haxe": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
        "rust": "cd $dir && mkdir -p output && rustc $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "racket": "racket",
        "scheme": "guile -s",
        "ahk": "autohotkey",
        "autoit": "autoit3",
        "dart": "dart",
        "pascal": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
        "d": "dmd -run",
        "haskell": "runghc",
        "nim": "cd $dir && mkdir -p output && nim compile --out:output/$fileNameWithoutExt --verbosity:0 --hints:off --run $fileName",
        "lisp": "sbcl --script",
        "kit": "kit run",
        "v": "v run",
        "sass": "sass --style expanded",
        "scss": "scss --style expanded",
        "less": "cd $dir && lessc $fileName $fileNameWithoutExt.css",
        "FortranFreeForm": "cd $dir && mkdir -p output && gfortran $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "fortran-modern": "cd $dir && mkdir -p output && gfortran $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "fortran_fixed-form": "cd $dir && mkdir -p output && gfortran $fileName -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "fortran": "cd $dir && mkdir -p output && gfortran -o output/$fileNameWithoutExt && $dir/output/$fileNameWithoutExt",
        "sml": "cd $dir && sml $fileName",
        "mojo": "pixi run mojo run",
        "erlang": "cd $dir && mkdir -p output && erlc -o output/ $fileName && cd output && erl -noshell -s $fileNameWithoutExt main -s init stop",
        "spwn": "spwn build",
        "pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
        "gleam": "gleam run -m $fileNameWithoutExt",
        "mmix": "cd $dir && ../../run-mmixal.sh $fileName",
        "ada": "cd $dir && mkdir -p output && gnatmake -q -D output -o output/$fileNameWithoutExt $fileName && $dir/output/$fileNameWithoutExt",
        "assembly": "cd $dir && ../../run-nasm.sh $fileName",
        "nasm": "cd $dir && ../../run-nasm.sh $fileName",
        "cobol": "cd $dir && mkdir -p output && cobc -x -o output/$fileNameWithoutExt $fileName && $dir/output/$fileNameWithoutExt",
        "basic": "cd $dir && mkdir -p output && cp $fileName output/ && cd output && fbc $fileName && $dir/output/$fileNameWithoutExt",
        "simula": "cd $dir && /home/derek/bin/simula -noPopup $dir$fileName",
        "prolog": "cd $dir && mkdir -p output && gplc $fileName -o output/$fileNameWithoutExt && cd output && ./$fileNameWithoutExt",
        "idris": "cd $dir && mkdir -p output && cp $fileName ./output/$fileName && cd output && idris2 $fileName -o $fileNameWithoutExt && ./build/exec/$fileNameWithoutExt",
        "mercury": "cd $dir && mkdir -p output && cp $fileName ./output/$fileNameWithoutExt.m && cd output && mmc $fileNameWithoutExt.m && ./$fileNameWithoutExt",
        "factor": "factor -run",
        "forth": "cd $dir && scp -P 2222 $fileName coderun@127.0.0.1:/home/coderun/codefiles/$fileName > /dev/null && ssh -p 2222 coderun@127.0.0.1 gforth ./codefiles/$fileName",
        "m3": "cd $dir && scp -P 2222 $fileName coderun@127.0.0.1:/home/coderun/codefiles/$fileName > /dev/null && ssh -p 2222 coderun@127.0.0.1 ./compile-run-modula-3.sh $fileName",
        "smalltalk": "cd $dir && scp -P 2222 $fileName coderun@127.0.0.1:/home/coderun/codefiles/$fileName > /dev/null && ssh -p 2222 coderun@127.0.0.1 gst ./codefiles/$fileName",
        "oberon": "cd $dir && scp -P 2222 $fileName coderun@127.0.0.1:/home/coderun/codefiles/$fileName > /dev/null && ssh -p 2222 coderun@127.0.0.1 ./compile-run-oberon.sh $fileName",
        "eiffel": "cd $dir && ../../run-eiffel.sh $fileName",
        "ballerina": "cd $dir && mkdir -p output && cp $fileName output/ && cd output && bal build $fileName > ballerina-build-last && java -jar $fileNameWithoutExt.jar",
    },
    "code-runner.executorMapByFileExtension": {
        ".nasm": "cd $dir && ../../run-nasm.sh $fileName",
        ".bas": "cd $dir && mkdir -p output && cp $fileName output/ && cd output && fbc $fileName && $dir/output/$fileNameWithoutExt",
        ".vb": "cd $dir && mkdir -p output && cp $fileName output/ && cd output && echo \"<Project Sdk=\\\"Microsoft.NET.Sdk\\\"><PropertyGroup><OutputType>Exe</OutputType><RootNamespace>Main</RootNamespace><TargetFramework>net10.0</TargetFramework></PropertyGroup></Project>\" > $fileNameWithoutExt.vbproj && dotnet run",
        ".vbs": "cscript //Nologo",
        ".scala": "scala",
        ".jl": "julia",
        ".cr": "crystal",
        ".ml": "ocaml",
        ".zig": "zig run",
        ".exs": "elixir",
        ".hx": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
        ".rkt": "racket",
        ".scm": "csi -script",
        ".ahk": "autohotkey",
        ".au3": "autoit3",
        ".kt": "cd $dir && kotlinc $fileName -include-runtime -d output/$fileNameWithoutExt.jar && cd output && java -jar $fileNameWithoutExt.jar",
        ".kts": "kotlinc -script",
        ".dart": "dart",
        ".pas": "cd $dir && mkdir -p output && cp $fileName ./output && cd output && fpc $fileName > /dev/null && ./$fileNameWithoutExt",
        ".pp": "cd $dir && fpc $fileName && $dir$fileNameWithoutExt",
        ".d": "cd $dir && dmd $fileName && $dir$fileNameWithoutExt",
        ".hs": "runhaskell",
        ".nim": "cd $dir && mkdir -p output && nim compile --out:output/$fileNameWithoutExt --verbosity:0 --hints:off --run $fileName",
        ".csproj": "dotnet run --project",
        ".fsproj": "dotnet run --project",
        ".lisp": "sbcl --script",
        ".kit": "kitc --run",
        ".v": "v run",
        ".vsh": "v run",
        ".sass": "sass --style expanded",
        ".cu": "cd $dir && nvcc $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
        ".ring": "ring",
        ".sml": "cd $dir && sml $fileName",
        ".mojo": "pixi run mojo run",
        ".erl": "escript",
        ".spwn": "spwn build",
        ".pkl": "cd $dir && pkl eval -f yaml $fileName -o $fileNameWithoutExt.yaml",
        ".gleam": "gleam run -m $fileNameWithoutExt",
        ".pl": "cd $dir && mkdir -p output && gplc $fileName -o output/$fileNameWithoutExt && cd output && ./$fileNameWithoutExt"
    },
    "C_Cpp.default.cStandard": "gnu23",
    "C_Cpp.default.cppStandard": "gnu++26",
    "workbench.iconTheme": "material-icon-theme",
    "files.associations": {
        "*.bas": "freebasic",
        "*.e": "eiffel",
        "*.m3": "m3",
        "*.factor": "factor",
        "*.pl": "prolog",
        "*.plx": "perl",
        "*.m": "objective-c",
        "*.Mod": "oberon",
        "*.mmc": "mercury",
        "*.mms": "mmix",
        "*.rkt": "racket",
        "*.st": "smalltalk",
        "*.kit": "kit",
    },
    "material-icon-theme.files.associations": {
        "*.bas": "freebasic",
        "*.e": "eiffel",
        "*.m3": "modula",
        "*.Mod": "oberon",
        "*.factor": "factor",
        "*.pl": "prolog",
        "*.plx": "perl",
        "*.m": "objective-c",
        "*.mms": "assembly",
        "*.mmc": "mercury",
        "*.nasm": "assembly",
        "*.st": "smalltalk",
        "*.kit": "kit",
    },
    "material-icon-theme.languages.associations": {
        "factor": "factor",
        "eiffel": "eiffel",
        "freebasic": "freebasic",
        "mercury": "mercury",
        "modula": "modula",
        "oberon": "oberon",
        "smalltalk": "smalltalk"
    }
}