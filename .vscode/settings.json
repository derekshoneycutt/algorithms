{
    "go.toolsEnvVars": {
        "CGO_ENABLED": "0",
    },
    "FSharp.suggestGitignore": false,
    "fortran.fortls.disabled": true,
    "code-runner.executorMap": {
        "ada": "cd $dir && ../../../run/ada.sh $fileName",
        "assembly": "cd $dir && ../../run/nasm.sh $fileName",
        "ballerina": "cd $dir && ../../../run/ballerina.sh $fileName",
        "c": "cd $dir && ../../../run/c.sh $fileName",
        "clojure": "cd $dir && ../../../run/clojure.sh $fileName",
        "cobol": "cd $dir && ../../../run/cobol.sh $fileName",
        "cpp": "cd $dir && ../../../run/cpp.sh $fileName",
        "csharp": "cd $dir && ../../../run/csharp.sh $fileName",
        "d": "cd $dir && ../../../run/d.sh $fileName",
        "dart": "cd $dir && ../../../run/dart.sh $fileName",
        "erlang": "cd $dir && ../../../run/erlang.sh $fileName",
        "eiffel": "cd $dir && ../../../run/eiffel.sh $fileName",
        "elixir": "cd $dir && ELIXIR_ERL_OPTIONS=\"+fnu\" ../../../run/elixir.sh $fileName",
        "factor": "cd $dir && ../../../run/factor.sh $fileName",
        "fsharp": "cd $dir && ../../../run/fsharp.sh $fileName",
        "forth": "cd $dir && ../../../run/forth.sh $fileName",
        "FortranFreeForm": "cd $dir && ../../../run/fortran.sh $fileName",
        "freebasic": "cd $dir && ../../../run/freebasic.sh $fileName",
        "gleam": "cd $dir && ../../../run/gleam.sh $fileName",
        "go": "cd $dir && ../../../run/go.sh $fileName",
        "haskell": "cd $dir && ../../../run/haskell.sh $fileName",
        "haxe": "cd $dir && ../../../run/haxe.sh $fileName",
        "idris": "cd $dir && ../../../run/idris.sh $fileName",
        "javascript": "cd $dir && ../../../run/node.sh $fileName",
        "java": "cd $dir && ../../../run/java.sh $fileName",
        "julia": "cd $dir && ../../../run/julia.sh $fileName",
        "kotlin": "cd $dir && ../../../run/kotlin.sh $fileName",
        "kit": "cd $dir && ../../../run/kit.sh $fileName",
        "llvm": "cd $dir && ../../../run/llvm.sh $fileName",
        "lua": "cd $dir && ../../../run/lua.sh $fileName",
        "m3": "cd $dir && ../../../run/modula3.sh $fileName",
        "mercury": "cd $dir && ../../../run/mercury.sh $fileName",
        "mmix": "cd $dir && ../../../run/mmixal.sh $fileName",
        "mojo": "cd $dir && ../../../run/mojo.sh $fileName",
        "asm-intel-x86-generic": "cd $dir && ../../../run/nasm.sh $fileName",
        "nim": "cd $dir && ../../../run/nim.sh $fileName",
        "oberon": "cd $dir && ../../../run/oberon.sh $fileName",
        "objective-c": "cd $dir && ../../../run/objective-c.sh $fileName",
        "ocaml": "cd $dir && ../../../run/ocaml.sh $fileName",
        "octave": "cd $dir && ../../../run/octave.sh $fileName",
        "objectpascal": "cd $dir && ../../../run/pascal.sh $fileName",
        "perl": "cd $dir && ../../../run/perl.sh $fileName",
        "php": "cd $dir && ../../../run/php.sh $fileName",
        "prolog": "cd $dir && ../../../run/prolog.sh $fileName",
        "python": "cd $dir && ../../../run/python.sh $fileName",
        "r": "cd $dir && ../../../run/r.sh $fileName",
        "racket": "cd $dir && ../../../run/racket.sh $fileName",
        "ruby": "cd $dir && ../../../run/ruby.sh $fileName",
        "rust": "cd $dir && ../../../run/rust.sh $fileName",
        "scala": "cd $dir && ../../../run/scala.sh $fileName",
        "scheme": "cd $dir && ../../../run/scheme.sh $fileName",
        "simula": "cd $dir && ../../../run/simula.sh $fileName",
        "smalltalk": "cd $dir && ../../../run/smalltalk.sh $fileName",
        "swift": "cd $dir && ../../../run/swift.sh $fileName",
        "tcl": "cd $dir && ../../../run/tcl.sh $fileName",
        "typescript": "cd $dir && ../../../run/typescript.sh $fileName",
        "unicon": "cd $dir && ../../../run/icon.sh $fileName",
        "v": "cd $dir && ../../../run/v.sh $fileName",
        "vb": "cd $dir && ../../../run/visualbasic.sh $fileName",
        "wat": "cd $dir && ../../../run/wasm.sh $fileName",
        "zig": "cd $dir && ../../../run/zig.sh $fileName",
    },
    "C_Cpp.default.cStandard": "gnu23",
    "C_Cpp.default.cppStandard": "gnu++26",
    "workbench.iconTheme": "material-icon-theme",
    "files.associations": {
        "*.bas": "freebasic",
        "*.e": "eiffel",
        "*.factor": "factor",
        "*.icn": "unicon",
        "*.m": "objective-c",
        "*.m3": "m3",
        "*.mat": "octave",
        "*.mmc": "mercury",
        "*.mms": "mmix",
        "*.Mod": "oberon",
        "*.pl": "prolog",
        "*.plx": "perl",
        "*.rkt": "racket",
        "*.st": "smalltalk",
        "*.kit": "kit",
        "*.vb": "vb",
    },
    "material-icon-theme.files.associations": {
        "*.bas": "freebasic",
        "*.e": "eiffel",
        "*.factor": "factor",
        "*.gleam": "gleam-lang",
        "*.icn": "icon",
        "*.kit": "kit",
        "*.m": "objective-c",
        "*.m3": "modula",
        "*.mat": "octave",
        "*.mms": "assembly",
        "*.mmc": "mercury",
        "*.Mod": "oberon",
        "*.nasm": "assembly",
        "*.pl": "prolog",
        "*.plx": "perl",
        "*.st": "smalltalk",
    },
    "material-icon-theme.languages.associations": {
        "eiffel": "eiffel",
        "factor": "factor",
        "freebasic": "freebasic",
        "gleam": "gleam-lang",
        "mercury": "mercury",
        "modula": "modula",
        "oberon": "oberon",
        "smalltalk": "smalltalk",
    }
}