%{
  Calculate the GCD for two numbers and print it all to the screen
%}

m = 0;
n = 0;

% Calculates the GCD using Euclid's method
function output = euclid_gcd(m, n)
  while n ~= 0
    r = mod(m, n);
    m = n;
    n = r;
  end
  output = m;
end

% attempt to get 2 command line arguments or use 15, 10
m = 15;
n = 10;
args = argv();
if length(args) > 1
    m = str2num(args{1});
    n = str2num(args{2});
end

disp([num2str(m), ' ', num2str(n)])
gcd = euclid_gcd(m, n);
disp(['gcd: ', num2str(gcd)]);
