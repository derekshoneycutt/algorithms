comment
    This program finds the maximum of a sequence of values
;
begin

    ! Get the max of the sequence;
    integer procedure max(x, n);
        integer array x;
        integer n;
    begin
        integer current, i;
        current := 0;
        for i := 1 step 1 until n do begin
            if x(i) > current then begin
                current := x(i);
            end;
        end;
        max := current;
    end;

    ! No command line arguments in simula, so we just seed some data;
    integer array numbers(1:10);
    integer i;
    numbers(1) := 23;
    numbers(2) := 43;
    numbers(3) := 1;
    numbers(4) := 63;
    numbers(5) := 35;
    numbers(6) := 72;
    numbers(7) := 12;
    numbers(8) := 29;
    numbers(9) := 50;
    numbers(10) := 6;

    outtext("values:"); outimage;
    for i := 1 step 1 until 10 do begin
        outint(numbers(i),2); outimage;
    end;
    outtext("max: "); outint(max(numbers, 10), 2); outimage;
end
