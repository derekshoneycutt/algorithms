comment
    This program finds the maximum of a sequence of values
;
begin
    ! Get the max of the sequence;
    integer procedure max(x, n);
        integer array x;
        integer n;
    begin
        integer current, i;
        current := 0;
        for i := 1 step 1 until n do begin
            if x(i) > current then begin
                current := x(i);
            end;
        end;
        max := current;
    end;

    integer size;
    size := 10;

    begin
        ! No command line arguments in simula, so we just seed some data;
        integer array numbers(1:size);
        integer i;
        text dt;
        integer seed;
        dt :- datetime;
        seed := ((dt.sub(15, 2).getint * 10000)) + ((dt.sub(18, 2).getint * 100)) + (dt.sub(21, 2).getint);
        for i := 1 step 1 until size do begin
            numbers(i) := uniform(1, 99, seed)
        end;

        outtext("values:"); outimage;
        for i := 1 step 1 until size do begin
            outint(numbers(i), 2); outimage;
        end;
        outtext("max: "); outint(max(numbers, size), 2); outimage;
    end
end
