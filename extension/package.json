{
  "name": "algorithms-runner-extension",
  "displayName": "Derek's Algorithms Runner",
  "description": "VS Code extension scaffold for run.sh integration.",
  "version": "0.0.1",
  "publisher": "derekshoneycutt",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "node": ">=18",
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "algosSidebar",
          "title": "Algorithms",
          "icon": "./icons/play-sidebar.svg"
        }
      ]
    },
    "views": {
      "algosSidebar": [
        {
          "id": "algosWorkspaceSmokeControlsView",
          "name": "Smoke Controls",
          "type": "webview",
          "icon": "./icons/play-sidebar.svg",
          "when": "algos.workspaceSupported",
          "visibility": "collapsed"
        },
        {
          "id": "algosWorkspaceRunControlsView",
          "name": "Run Controls",
          "type": "webview",
          "icon": "./icons/play-sidebar.svg",
          "when": "algos.workspaceSupported",
          "visibility": "collapsed"
        },
        {
          "id": "algosWorkspaceAlgorithmsRunView",
          "name": "Algorithms",
          "icon": "./icons/play-sidebar.svg",
          "when": "algos.workspaceSupported"
        },
        {
          "id": "algosWorkspaceStandardLibraryView",
          "name": "Standard Library",
          "icon": "./icons/play-sidebar.svg",
          "when": "algos.workspaceSupported"
        },
        {
          "id": "algosWorkspaceEnvironmentView",
          "name": "Environment",
          "type": "webview",
          "icon": "./icons/play-sidebar.svg",
          "when": "algos.workspaceSupported",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "algos.runActiveFile",
        "title": "Run File",
        "category": "Derek's Algorithms",
        "icon": "$(play)"
      },
      {
        "command": "algos.runFile",
        "title": "Run File",
        "category": "Derek's Algorithms",
        "icon": "$(play)"
      },
      {
        "command": "algos.runLanguage",
        "title": "Run Language",
        "category": "Derek's Algorithms",
        "icon": "$(play)"
      },
      {
        "command": "algos.runSmokeTest",
        "title": "Smoke Test",
        "category": "Derek's Algorithms",
        "icon": "$(play)"
      },
      {
        "command": "algos.runSmokeTestStop",
        "title": "Stop Smoke Test",
        "category": "Derek's Algorithms",
        "icon": "$(debug-stop)"
      },
      {
        "command": "algos.runSmokeTestClearResults",
        "title": "Clear Smoke Results",
        "category": "Derek's Algorithms",
        "icon": "$(clear-all)"
      },
      {
        "command": "algos.flagLanguage",
        "title": "Flag Language",
        "category": "Derek's Algorithms",
        "icon": "$(bookmark)"
      },
      {
        "command": "algos.unflagLanguage",
        "title": "Unflag Language",
        "category": "Derek's Algorithms",
        "icon": "$(close)"
      },
      {
        "command": "algos.openRunMenu",
        "title": "Run Menu",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runClean",
        "title": "Clean",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runLocalClean",
        "title": "Local Clean",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runActiveFileCompileOnly",
        "title": "Compile Only",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runLanguageCompileOnly",
        "title": "Compile Only",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runActiveFileCheckOnlyNative",
        "title": "Check Only (Native)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runLanguageCheckOnlyNative",
        "title": "Check Only (Native)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runActiveFileCheckOnlyDocker",
        "title": "Check Only (Docker)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runLanguageCheckOnlyDocker",
        "title": "Check Only (Docker)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runActiveFileCheckOnlySsh",
        "title": "Check Only (SSH)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runLanguageCheckOnlySsh",
        "title": "Check Only (SSH)",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runMenuClean",
        "title": "Clean",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runMenuLocalclean",
        "title": "Local Clean",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runMenuCompileOnly",
        "title": "Compile Only",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.runMenuCheckOnly",
        "title": "Check Only",
        "category": "Derek's Algorithms"
      },
      {
        "command": "algos.sidebarShowFileView",
        "title": "Show File View",
        "category": "Derek's Algorithms",
        "icon": "$(files)"
      },
      {
        "command": "algos.sidebarShowLanguageView",
        "title": "Show Language View",
        "category": "Derek's Algorithms",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "algos.sidebarShowAllFilter",
        "title": "Show All Rows",
        "category": "Derek's Algorithms",
        "icon": "$(clear-all)"
      },
      {
        "command": "algos.sidebarShowProblemsFilter",
        "title": "Show Problem Rows",
        "category": "Derek's Algorithms",
        "icon": "$(filter)"
      },
      {
        "command": "algos.createLanguageFilePlaceholder",
        "title": "Create Language File",
        "category": "Derek's Algorithms",
        "icon": "$(add)"
      },
      {
        "command": "algos.algorithmsCreateFolderAtSrcRoot",
        "title": "New Folder",
        "category": "Derek's Algorithms",
        "icon": "$(new-folder)"
      },
      {
        "command": "algos.algorithmsCreateFolder",
        "title": "New Folder",
        "category": "Derek's Algorithms",
        "icon": "$(new-folder)"
      },
      {
        "command": "algos.algorithmsCreateFile",
        "title": "New File",
        "category": "Derek's Algorithms",
        "icon": "$(new-file)"
      },
      {
        "command": "algos.algorithmsAddIncludeFile",
        "title": "Add Include File",
        "category": "Derek's Algorithms",
        "icon": "$(new-file)"
      },
      {
        "command": "algos.algorithmsDeleteItem",
        "title": "Delete",
        "category": "Derek's Algorithms",
        "icon": "$(trash)"
      },
      {
        "command": "algos.standardLibraryCreateFile",
        "title": "Create File",
        "category": "Derek's Algorithms",
        "icon": "$(new-file)"
      },
      {
        "command": "algos.standardLibraryCreateFileAtRoot",
        "title": "Create File",
        "category": "Derek's Algorithms",
        "icon": "$(new-file)"
      },
      {
        "command": "algos.standardLibraryCreateFolder",
        "title": "Create Folder",
        "category": "Derek's Algorithms",
        "icon": "$(new-folder)"
      },
      {
        "command": "algos.standardLibraryCreateFolderAtRoot",
        "title": "Create Folder",
        "category": "Derek's Algorithms",
        "icon": "$(new-folder)"
      },
      {
        "command": "algos.standardLibraryDelete",
        "title": "Delete",
        "category": "Derek's Algorithms",
        "icon": "$(trash)"
      }
    ],
    "submenus": [
      {
        "id": "algos.runMenuExplorer",
        "label": "Run Menu"
      },
      {
        "id": "algos.runMenuSidebar",
        "label": "Run Menu",
        "icon": "$(kebab-vertical)"
      },
      {
        "id": "algos.runMenuSidebarLanguage",
        "label": "Run Menu",
        "icon": "$(kebab-vertical)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algos.runActiveFile",
          "when": "algos.canRunActiveFile",
          "group": "1_run@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "algos.runActiveFile",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@1"
        },
        {
          "command": "algos.runClean",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@2"
        },
        {
          "command": "algos.runLocalClean",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@3"
        },
        {
          "command": "algos.runActiveFileCompileOnly",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@4"
        },
        {
          "command": "algos.runActiveFileCheckOnlyNative",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@5"
        },
        {
          "command": "algos.runActiveFileCheckOnlyDocker",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@6"
        },
        {
          "command": "algos.runActiveFileCheckOnlySsh",
          "when": "algos.canRunActiveFile",
          "group": "1_actions@7"
        }
      ],
      "explorer/context": [
        {
          "command": "algos.runFile",
          "when": "explorerResourceIsFolder == false && resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+$/",
          "group": "1_modification@-1"
        },
        {
          "when": "resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/][^\\\\/]+)?$/",
          "group": "1_modification@-2",
          "submenu": "algos.runMenuExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "algos.runSmokeTest",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceAlgorithmDirectory || viewItem == algos.workspaceAlgorithmDirectoryResults)",
          "group": "inline@1"
        },
        {
          "command": "algos.runSmokeTestStop",
          "when": "view == algosWorkspaceAlgorithmsRunView && viewItem == algos.workspaceAlgorithmDirectoryRunning",
          "group": "inline@1"
        },
        {
          "command": "algos.runSmokeTestClearResults",
          "when": "view == algosWorkspaceAlgorithmsRunView && viewItem == algos.workspaceAlgorithmDirectoryResults",
          "group": "inline@2"
        },
        {
          "command": "algos.runFile",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged)",
          "group": "inline@1"
        },
        {
          "command": "algos.runLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "inline@1"
        },
        {
          "command": "algos.flagLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceFileUnflagged || viewItem == algos.languagePresentUnflagged || viewItem == algos.languageMissingUnflagged)",
          "group": "inline@4"
        },
        {
          "command": "algos.unflagLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileFlagged || viewItem == algos.workspaceFileFlagged || viewItem == algos.languagePresentFlagged || viewItem == algos.languageMissingFlagged)",
          "group": "inline@4"
        },
        {
          "command": "algos.algorithmsCreateFolder",
          "when": "view == algosWorkspaceAlgorithmsRunView && viewItem == algos.workspaceCategoryDirectory",
          "group": "inline@1"
        },
        {
          "command": "algos.algorithmsDeleteItem",
          "when": "view == algosWorkspaceAlgorithmsRunView && viewItem == algos.workspaceCategoryDirectory",
          "group": "inline@2"
        },
        {
          "command": "algos.algorithmsCreateFile",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceAlgorithmDirectory || viewItem == algos.workspaceAlgorithmDirectoryRunning || viewItem == algos.workspaceAlgorithmDirectoryResults)",
          "group": "inline@3"
        },
        {
          "command": "algos.algorithmsDeleteItem",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceAlgorithmDirectory || viewItem == algos.workspaceAlgorithmDirectoryRunning || viewItem == algos.workspaceAlgorithmDirectoryResults)",
          "group": "inline@4"
        },
        {
          "command": "algos.algorithmsAddIncludeFile",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged || viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "inline@2"
        },
        {
          "command": "algos.algorithmsDeleteItem",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged || viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "inline@3"
        },
        {
          "command": "algos.algorithmsDeleteItem",
          "when": "view == algosWorkspaceAlgorithmsRunView && viewItem == algos.workspaceIncludeFile",
          "group": "inline@1"
        },
        {
          "command": "algos.runFile",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceFileUnflagged || viewItem == algos.workspaceFileFlagged || viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged)",
          "group": "1_modification@-2"
        },
        {
          "command": "algos.runLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "1_modification@-2"
        },
        {
          "command": "algos.flagLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceFileUnflagged || viewItem == algos.languagePresentUnflagged || viewItem == algos.languageMissingUnflagged)",
          "group": "1_modification@-1"
        },
        {
          "command": "algos.unflagLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceRunnableFileFlagged || viewItem == algos.workspaceFileFlagged || viewItem == algos.languagePresentFlagged || viewItem == algos.languageMissingFlagged)",
          "group": "1_modification@-1"
        },
        {
          "submenu": "algos.runMenuSidebar",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceFileUnflagged || viewItem == algos.workspaceFileFlagged || viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged)",
          "group": "inline@5"
        },
        {
          "submenu": "algos.runMenuSidebarLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "inline@5"
        },
        {
          "submenu": "algos.runMenuSidebar",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.workspaceFileUnflagged || viewItem == algos.workspaceFileFlagged || viewItem == algos.workspaceRunnableFileUnflagged || viewItem == algos.workspaceRunnableFileFlagged)",
          "group": "1_modification@0"
        },
        {
          "submenu": "algos.runMenuSidebarLanguage",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.languagePresentUnflagged || viewItem == algos.languagePresentFlagged)",
          "group": "1_modification@0"
        },
        {
          "command": "algos.createLanguageFilePlaceholder",
          "when": "view == algosWorkspaceAlgorithmsRunView && (viewItem == algos.languageMissingUnflagged || viewItem == algos.languageMissingFlagged)",
          "group": "inline@1"
        },
        {
          "command": "algos.standardLibraryCreateFile",
          "when": "view == algosWorkspaceStandardLibraryView && viewItem == standardLibraryDirectory",
          "group": "inline@1"
        },
        {
          "command": "algos.standardLibraryCreateFolder",
          "when": "view == algosWorkspaceStandardLibraryView && viewItem == standardLibraryDirectory",
          "group": "inline@2"
        },
        {
          "command": "algos.standardLibraryDelete",
          "when": "view == algosWorkspaceStandardLibraryView && (viewItem == standardLibraryDirectory || viewItem == standardLibraryFile)",
          "group": "inline@3"
        }
      ],
      "view/title": [
        {
          "command": "algos.algorithmsCreateFolderAtSrcRoot",
          "when": "view == algosWorkspaceAlgorithmsRunView",
          "group": "navigation@0"
        },
        {
          "command": "algos.sidebarShowFileView",
          "when": "view == algosWorkspaceAlgorithmsRunView && algos.sidebarViewMode == language",
          "group": "navigation@1"
        },
        {
          "command": "algos.sidebarShowLanguageView",
          "when": "view == algosWorkspaceAlgorithmsRunView && algos.sidebarViewMode == files",
          "group": "navigation@2"
        },
        {
          "command": "algos.sidebarShowAllFilter",
          "when": "view == algosWorkspaceAlgorithmsRunView && algos.sidebarFilterMode == problems",
          "group": "navigation@3"
        },
        {
          "command": "algos.sidebarShowProblemsFilter",
          "when": "view == algosWorkspaceAlgorithmsRunView && algos.sidebarFilterMode == all",
          "group": "navigation@4"
        },
        {
          "command": "algos.standardLibraryCreateFileAtRoot",
          "when": "view == algosWorkspaceStandardLibraryView",
          "group": "navigation@1"
        },
        {
          "command": "algos.standardLibraryCreateFolderAtRoot",
          "when": "view == algosWorkspaceStandardLibraryView",
          "group": "navigation@2"
        }
      ],
      "algos.runMenuExplorer": [
        {
          "command": "algos.runFile",
          "group": "run@1"
        },
        {
          "command": "algos.runMenuCompileOnly",
          "when": "resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/][^\\\\/]+)?$/",
          "group": "run@2"
        },
        {
          "command": "algos.runMenuCheckOnly",
          "when": "resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/][^\\\\/]+)?$/",
          "group": "run@3"
        },
        {
          "command": "algos.runMenuClean",
          "when": "resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/][^\\\\/]+)?$/",
          "group": "run@4"
        },
        {
          "command": "algos.runMenuLocalclean",
          "when": "resourcePath =~ /[\\\\/]src[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/][^\\\\/]+)?$/",
          "group": "run@5"
        }
      ],
      "algos.runMenuSidebar": [
        {
          "command": "algos.runFile",
          "group": "run@1"
        },
        {
          "command": "algos.runMenuCompileOnly",
          "group": "run@2"
        },
        {
          "command": "algos.runMenuCheckOnly",
          "group": "run@3"
        },
        {
          "command": "algos.runMenuClean",
          "group": "run@4"
        },
        {
          "command": "algos.runMenuLocalclean",
          "group": "run@5"
        }
      ],
      "algos.runMenuSidebarLanguage": [
        {
          "command": "algos.runLanguage"
        },
        {
          "command": "algos.runMenuClean"
        },
        {
          "command": "algos.runMenuLocalclean"
        },
        {
          "command": "algos.runLanguageCompileOnly"
        },
        {
          "command": "algos.runLanguageCheckOnlyNative"
        },
        {
          "command": "algos.runLanguageCheckOnlyDocker"
        },
        {
          "command": "algos.runLanguageCheckOnlySsh"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint src test --ext .js",
    "test": "node test/run.js",
    "validate": "npm run lint && npm test",
    "build:vsix": "mkdir -p dist && vsce package --allow-missing-repository --out ./dist/ && echo \"\\n--- VSIX built successfully ---\" && echo \"File: $(ls -1t dist/*.vsix | head -1)\" && echo \"Install: code --install-extension <vsix-path>\""
  },
  "devDependencies": {
    "eslint": "^9.36.0"
  }
}
